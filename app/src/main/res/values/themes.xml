<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Zmywarka" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/tomato</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorSecondary">@color/mint</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="colorSurface">@color/cream</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="android:colorBackground">@color/paper</item>

        <item name="android:statusBarColor">@color/tomato</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="fontFamily">@font/space_mono</item>
        <item name="android:fontFamily">@font/space_mono</item>

        <item name="toolbarStyle">@style/Widget.Brutal.Toolbar</item>
        <item name="materialButtonStyle">@style/Widget.Brutal.Button</item>
    </style>

    <!-- Weight screen: mint status bar -->
    <style name="Theme.Zmywarka.Weight" parent="Theme.Zmywarka">
        <item name="colorPrimary">@color/mint</item>
        <item name="android:statusBarColor">@color/mint</item>
        <item name="toolbarStyle">@style/Widget.Brutal.Toolbar.Mint</item>
    </style>

    <!-- ===================== Type ===================== -->

    <style name="TextAppearance.Brutal.Hero" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/archivo_black</item>
        <item name="fontFamily">@font/archivo_black</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">46sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Brutal.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/archivo_black</item>
        <item name="fontFamily">@font/archivo_black</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.Brutal.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/space_mono</item>
        <item name="fontFamily">@font/space_mono</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
    </style>

    <style name="TextAppearance.Brutal.Toolbar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/archivo_black</item>
        <item name="fontFamily">@font/archivo_black</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">19sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- ===================== Widgets ===================== -->

    <style name="Widget.Brutal.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/tomato</item>
        <item name="titleTextColor">@color/ink</item>
        <item name="titleTextAppearance">@style/TextAppearance.Brutal.Toolbar</item>
        <item name="navigationIconTint">@color/ink</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.Brutal.Toolbar.Mint">
        <item name="android:background">@color/mint</item>
    </style>

    <style name="Widget.Brutal.Button" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/btn_brutal</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">@font/archivo_black</item>
        <item name="fontFamily">@font/archivo_black</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">62dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">20dp</item>
    </style>

    <style name="Widget.Brutal.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/ink</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="boxStrokeWidthFocused">3dp</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxCornerRadiusTopStart">3dp</item>
        <item name="boxCornerRadiusTopEnd">3dp</item>
        <item name="boxCornerRadiusBottomStart">3dp</item>
        <item name="boxCornerRadiusBottomEnd">3dp</item>
        <item name="hintTextColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_soft</item>
        <item name="android:fontFamily">@font/space_mono</item>
        <item name="fontFamily">@font/space_mono</item>
    </style>

</resources>
