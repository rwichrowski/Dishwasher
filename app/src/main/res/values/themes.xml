<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         "ALMANACH" theme — warm botanical kitchen almanac
         ============================================================ -->

    <style name="Theme.Zmywarka" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/terracotta</item>
        <item name="colorOnPrimary">@color/bone</item>
        <item name="colorSecondary">@color/verdigris</item>
        <item name="colorOnSecondary">@color/bone</item>
        <item name="colorSurface">@color/cream</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="android:colorBackground">@color/paper</item>

        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="fontFamily">@font/dm_mono</item>
        <item name="android:fontFamily">@font/dm_mono</item>

        <item name="toolbarStyle">@style/Widget.Brutal.Toolbar</item>
    </style>

    <!-- ===================== Type ===================== -->

    <!-- Masthead / toolbar title -->
    <style name="TextAppearance.Almanac.Masthead" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/fraunces_semibold</item>
        <item name="fontFamily">@font/fraunces_semibold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Big featured name -->
    <style name="TextAppearance.Almanac.Hero" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/fraunces_black</item>
        <item name="fontFamily">@font/fraunces_black</item>
        <item name="android:textColor">@color/bone</item>
        <item name="android:textSize">44sp</item>
        <item name="android:letterSpacing">-0.025</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Section titles inside panels -->
    <style name="TextAppearance.Almanac.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/fraunces_semibold</item>
        <item name="fontFamily">@font/fraunces_semibold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">21sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Tracked mono kicker / overline labels -->
    <style name="TextAppearance.Almanac.Kicker" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/dm_mono</item>
        <item name="fontFamily">@font/dm_mono</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.22</item>
    </style>

    <!-- Italic editorial caption -->
    <style name="TextAppearance.Almanac.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/fraunces_italic</item>
        <item name="fontFamily">@font/fraunces_italic</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- ===================== Widgets ===================== -->

    <style name="Widget.Brutal.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextColor">@color/ink</item>
        <item name="titleTextAppearance">@style/TextAppearance.Almanac.Masthead</item>
        <item name="navigationIconTint">@color/ink</item>
        <item name="android:elevation">0dp</item>
    </style>

</resources>
