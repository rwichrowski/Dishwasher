<?xml version="1.0" encoding="utf-8"?>
<!-- The current week — a faint terracotta wash marked by a solid left bar -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#18C24E2C" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:gravity="left|fill_vertical" android:width="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/terracotta" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/terracotta" />
        </shape>
    </item>
</layer-list>
