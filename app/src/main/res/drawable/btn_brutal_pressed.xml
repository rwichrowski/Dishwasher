<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed: fill shifts down-right into the shadow, shadow collapses -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/mint_dark" />
            <stroke android:width="3dp" android:color="@color/ink" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
