<?xml version="1.0" encoding="utf-8"?>
<!-- Ledger header accent block (weight screen counterpart of card_feature) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="4dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:right="3dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="115"
                android:startColor="#318675"
                android:endColor="@color/verdigris"
                android:type="linear" />
            <stroke android:width="1.5dp" android:color="@color/verdigris_ink" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
