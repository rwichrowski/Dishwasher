<?xml version="1.0" encoding="utf-8"?>
<!-- Parchment panel: fine ink keyline over a soft printed drop-shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="3dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A1E2A24" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:right="2dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/cream" />
            <stroke android:width="1.5dp" android:color="@color/ink" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
