<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/paper_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="34dp">

            <!-- ===================== MASTHEAD ===================== -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:background="@color/ink" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/almanac_kicker"
                android:textAppearance="@style/TextAppearance.Almanac.Kicker" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="@string/main_masthead"
                android:textAppearance="@style/TextAppearance.Almanac.Masthead"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/tvWeekKicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/terracotta_dark"
                android:fontFamily="@font/dm_mono_medium"
                android:letterSpacing="0.14"
                android:textSize="11sp"
                tools:text="✦  TYDZIEŃ 24 · 2026  ✦" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginTop="12dp"
                android:background="@color/ink" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="3dp"
                android:background="@color/rule" />

            <!-- ===================== FEATURED DUTY ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/card_feature"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingTop="24dp"
                android:paddingEnd="26dp"
                android:paddingBottom="26dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/now_on_duty"
                    android:textAppearance="@style/TextAppearance.Almanac.Kicker"
                    android:textColor="#F4D9C9" />

                <TextView
                    android:id="@+id/tvCurrentPerson"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Almanac.Hero"
                    tools:text="Antek" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/hero_caption"
                    android:textAppearance="@style/TextAppearance.Almanac.Caption"
                    android:textColor="#F4D9C9" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="#59FBF6E9" />

                <TextView
                    android:id="@+id/tvHeroDates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/dm_mono"
                    android:letterSpacing="0.06"
                    android:textColor="#FBF1E8"
                    android:textSize="12.5sp"
                    tools:text="11–17 MAJA · TYDZIEŃ DYŻURU" />

            </LinearLayout>

            <!-- ===================== NEXT IN LINE ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/card_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="16dp"
                android:paddingEnd="22dp"
                android:paddingBottom="18dp">

                <View
                    android:layout_width="5dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="18dp"
                    android:background="@color/ochre" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/upcoming_queue"
                        android:textAppearance="@style/TextAppearance.Almanac.Kicker" />

                    <TextView
                        android:id="@+id/tvQueue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/fraunces_semibold"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        tools:text="od 18 maja — Weronika" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="▸"
                    android:textColor="@color/ochre_deep"
                    android:textSize="24sp" />

            </LinearLayout>

            <!-- ===================== ROTATION TABLE ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/card_panel"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="22dp"
                android:paddingEnd="24dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:text="✻"
                        android:textColor="@color/terracotta"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/calendar_title"
                        android:textAppearance="@style/TextAppearance.Almanac.Section" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:layout_marginTop="1dp"
                    android:text="@string/calendar_sub"
                    android:textAppearance="@style/TextAppearance.Almanac.Kicker" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/rule" />

                <LinearLayout
                    android:id="@+id/calendarLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- ===================== FOOTER ===================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:text="✦   ✦   ✦"
                android:textColor="@color/rule"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/footer_note"
                android:textAppearance="@style/TextAppearance.Almanac.Caption" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/dm_mono"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:textColor="@color/ink_soft"
                android:textSize="10sp"
                tools:text="v1.0" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
